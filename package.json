{
  "name": "easy-currency-converter",
  "version": "1.0.0",
  "main": "./app.tsx",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile --typescript",
    "clean": "rm -rf node_modules .expo package-lock.json",
    "postinstall": "npm run i18n:extract && npm run i18n:compile"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@lingui/core": "^5.5.0",
    "@lingui/react": "^5.5.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "crypto-js": "^4.2.0",
    "expo": "^53.0.27",
    "expo-application": "~6.1.5",
    "expo-constants": "~17.1.8",
    "expo-linking": "~7.1.7",
    "expo-localization": "~16.1.6",
    "expo-navigation-bar": "~4.2.8",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-symbols": "~0.4.5",
    "expo-system-ui": "~5.0.11",
    "react": "^19.0.0",
    "react-native": "^0.79.6",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@lingui/babel-plugin-lingui-macro": "^5.5.0",
    "@lingui/cli": "^5.5.0",
    "@types/crypto-js": "^4.2.2",
    "@types/react": "~19.0.10",
    "typescript": "~5.8.3"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "crypto-js"
        ]
      }
    }
  }
}
