{
  "expo": {
    "name": "Currency Converter",
    "slug": "easy-currency-converter",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icons/ios/ios-light.png",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#002395",
    "platforms": [
      "ios",
      "android"
    ],
    "githubUrl": "https://github.com/Cooty/currency-converter",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cooty.easyCurrencyConverter",
      "icon": {
        "light": "./assets/icons/ios/ios-light.png",
        "dark": "./assets/icons/ios/ios-dark.png",
        "tinted": "./assets/icons/ios/ios-tinted.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/android/adaptive-icon.png",
        "backgroundColor": "#002395",
        "monochromeImage": "./assets/icons/android/icon-monochrome-with-background.png"
      },
      "package": "com.cooty.easyCurrencyConverter"
    },
    "extra": {
      "eas": {
        "projectId": "e8e0a6e9-6edb-483e-a5ec-c13f7db5b8fb"
      }
    },
    "owner": "cooty",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/splash/splash-icon-light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#002395",
          "dark": {
            "image": "./assets/icons/splash/splash-icon-dark.png",
            "backgroundColor": "#1C1E1F"
          }
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "currency-converter-app",
          "organization": "cooty"
        }
      ],
      "@sentry/react-native",
      "expo-font",
      "expo-localization"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e8e0a6e9-6edb-483e-a5ec-c13f7db5b8fb"
    }
  }
}
